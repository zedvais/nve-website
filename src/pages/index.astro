---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import Marquee from '@/components/art/Marquee.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import ValuesGrid from '@/components/sections/ValuesGrid.astro';
import NightScene from '@/components/sections/NightScene.astro';
import FamilySection from '@/components/sections/FamilySection.astro';
import HighlightsSection from '@/components/sections/HighlightsSection.astro';
import RecruitmentSection from '@/components/sections/RecruitmentSection.astro';
---

<BaseLayout>
  <HeroSection />
  <Marquee items={['Loyalty', 'Integrity', 'Supportive', 'Ambition', 'Noctus Volpe', 'United as one']} />
  <AboutSection />
  <ValuesGrid />
  <NightScene />
  <FamilySection />
  <HighlightsSection />
  <RecruitmentSection />
</BaseLayout>
