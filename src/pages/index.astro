---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import ValueLine from '@/components/art/ValueLine.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import ValuesGrid from '@/components/sections/ValuesGrid.astro';
import HouseInterlude from '@/components/sections/HouseInterlude.astro';
import FamilySection from '@/components/sections/FamilySection.astro';
import HighlightsSection from '@/components/sections/HighlightsSection.astro';
import RecruitmentSection from '@/components/sections/RecruitmentSection.astro';
---

<BaseLayout>
  <HeroSection />
  <ValueLine items={['Loyalty', 'Integrity', 'Supportive', 'Ambition']} />
  <AboutSection />
  <ValuesGrid />
  <HouseInterlude />
  <FamilySection />
  <HighlightsSection />
  <RecruitmentSection />
</BaseLayout>
