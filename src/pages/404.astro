---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="flex min-h-svh items-center pt-20">
    <Container>
      <p class="eyebrow mb-6 text-accent-soft">Error 404</p>
      <h1 class="display text-[clamp(3rem,12vw,9rem)]">Lost the trail.</h1>
      <p class="mt-6 max-w-md text-lg text-muted">The page you are looking for does not exist or has moved.</p>
      <Button href="/" size="lg" class="mt-10">Back to home</Button>
    </Container>
  </section>
</BaseLayout>
