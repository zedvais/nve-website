---
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Container from '@/components/ui/Container.astro';
import NightSkyline from '@/components/art/NightSkyline.astro';
import DecoDivider from '@/components/art/DecoDivider.astro';
import Logo from '@/components/ui/Logo.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { game, navigation, site } from '@/data/site';
import { activeSocials, discord, hasDiscord } from '@/data/socials';

const year = new Date().getFullYear();
const [lineStart, lineEnd] = site.footerLine.split(' — ');
---

<footer class="relative overflow-hidden border-t border-line bg-bg pt-20 sm:pt-28">
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[60%] bg-[radial-gradient(60%_80%_at_50%_100%,rgb(74_62_140/0.28),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <NightSkyline class="pointer-events-none absolute inset-x-0 bottom-0 h-56 w-full text-[#100f18] sm:h-72" seed={19} count={40} />
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-bg from-35% via-bg/60 to-transparent" aria-hidden="true"></div>

  <Container size="wide" class="relative">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/#home" class="inline-flex items-center gap-3">
          <Logo variant="lockup" size={92} loading="lazy" />
        </a>
        <p class="mt-6 max-w-sm leading-relaxed text-muted">{site.tagline}</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">A family in {game.name} on {game.platform}.</p>
        {
          game.url && (
            <a
              href={game.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center gap-2 font-display text-xs font-semibold uppercase tracking-[0.16em] text-fg/80 transition-colors hover:text-accent-soft"
            >
              Play {game.name} on {game.platform}
              <ArrowUpRight size={14} stroke-width={2} aria-hidden="true" />
            </a>
          )
        }
      </div>

      <nav aria-label="Footer" class="lg:col-span-3">
        <h2 class="eyebrow mb-5">Navigate</h2>
        <ul class="space-y-3">
          {
            navigation.map((link) => (
              <li>
                <a href={link.href} class="text-fg/80 transition-colors hover:text-accent-soft">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <h2 class="eyebrow mb-5">Community</h2>
        {
          hasDiscord ? (
            <a
              href={discord.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 text-fg/80 transition-colors hover:text-accent-soft"
            >
              <SocialIcon icon="discord" size={18} />
              Join our Discord
            </a>
          ) : (
            <p class="flex items-center gap-3 text-muted">
              <SocialIcon icon="discord" size={18} />
              Discord invite coming soon
            </p>
          )
        }
        {
          activeSocials.filter((s) => s.icon !== 'discord').length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Social media">
              {activeSocials
                .filter((s) => s.icon !== 'discord')
                .map((s) => (
                  <li>
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-grid size-11 place-items-center border border-line text-muted transition-colors hover:border-accent/70 hover:text-fg"
                    >
                      <SocialIcon icon={s.icon} size={18} />
                      <span class="sr-only">{s.name}</span>
                    </a>
                  </li>
                ))}
            </ul>
          )
        }
      </div>
    </div>

    <DecoDivider class="mt-20" />

    <p
      class="display mt-16 select-none text-[clamp(2.25rem,8.5vw,8.5rem)] leading-[0.9] text-fg/90"
    >
      <span class="sr-only">{site.footerLine}</span>
      <span aria-hidden="true">{lineStart}</span>
      <span class="block text-transparent [-webkit-text-stroke:1px_rgb(243_241_255/0.35)]" aria-hidden="true">
        — {lineEnd}
      </span>
    </p>

    <div class="mt-14 flex flex-col-reverse gap-6 border-t border-line py-8 text-sm text-muted sm:flex-row sm:items-end sm:justify-between">
      <div class="space-y-1">
        <p>&copy; {year} {site.name}. All rights reserved.</p>
        <p class="text-xs text-muted/80">{game.disclaimer}</p>
      </div>
      <a href="#home" class="inline-flex items-center gap-2 transition-colors hover:text-fg">
        Back to top
        <ArrowUp size={16} stroke-width={1.5} aria-hidden="true" />
      </a>
    </div>
  </Container>
</footer>
