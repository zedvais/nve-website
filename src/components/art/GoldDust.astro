---
/**
 * A few specks of gold leaf drifting slowly upwards, catching the light as they
 * turn. Original artwork, CSS only. Positions come from a fixed seed, so every
 * build is the same. Paused off screen, hidden for reduced motion.
 */
import { seededRandom } from '@/lib/random';

interface Props {
  class?: string;
  count?: number;
  seed?: number;
}
const { class: className, count = 16, seed = 11 } = Astro.props;
const rand = seededRandom(seed);
const specks = Array.from({ length: count }, () => ({
  left: (rand() * 100).toFixed(1),
  size: (2 + rand() * 3).toFixed(1),
  duration: (18 + rand() * 16).toFixed(1),
  delay: (-rand() * 30).toFixed(1),
  drift: Math.round((rand() - 0.5) * 120),
  opacity: (0.35 + rand() * 0.45).toFixed(2),
}));
---

<div class:list={['gold-dust pointer-events-none overflow-hidden', className]} aria-hidden="true">
  {
    specks.map((s) => (
      <span
        style={`left:${s.left}%;width:${s.size}px;height:${s.size}px;--dust-duration:${s.duration}s;--dust-delay:${s.delay}s;--dust-drift:${s.drift}px;--dust-opacity:${s.opacity}`}
      />
    ))
  }
</div>
