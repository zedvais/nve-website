---
/**
 * Slowly rotating HUD rings with orbiting nodes. Original artwork.
 * Pure SVG + CSS animation (see .spin / .spin-rev in global.css).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 400 400" class:list={['pointer-events-none overflow-visible', className]} aria-hidden="true" focusable="false" fill="none">
  <g class="spin" style="--spin-duration:60s">
    <circle cx="200" cy="200" r="190" stroke="#f3f1ff" stroke-opacity="0.08" stroke-dasharray="2 10"></circle>
    <circle cx="200" cy="10" r="3.5" fill="#b9a4fb"></circle>
    <circle cx="10" cy="200" r="2" fill="#f3f1ff" fill-opacity="0.6"></circle>
  </g>
  <g class="spin-rev" style="--spin-duration:42s">
    <circle cx="200" cy="200" r="158" stroke="#8b5cf6" stroke-opacity="0.35" stroke-dasharray="60 18 4 18"></circle>
    <circle cx="358" cy="200" r="4" fill="#8b5cf6"></circle>
    <circle cx="358" cy="200" r="10" fill="#8b5cf6" fill-opacity="0.2" class="ping"></circle>
  </g>
  <g class="spin" style="--spin-duration:28s">
    <circle cx="200" cy="200" r="126" stroke="#b9a4fb" stroke-opacity="0.18" stroke-dasharray="1 6" stroke-linecap="round"></circle>
    <path d="M200 74a126 126 0 0 1 109 63" stroke="#b9a4fb" stroke-opacity="0.7" stroke-width="1.5" stroke-linecap="round"></path>
  </g>
  <!-- tick marks -->
  <g stroke="#f3f1ff" stroke-opacity="0.25">
    <path d="M200 0v14M200 386v14M0 200h14M386 200h14"></path>
  </g>
</svg>
