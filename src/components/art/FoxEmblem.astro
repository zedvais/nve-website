---
/**
 * Original faceted (low-poly) fox head illustration.
 * Decorative artwork, not the Noctus Volpe logo.
 */
interface Props {
  class?: string;
  /** "color" uses purple gradients, "mono" is a flat silhouette for small sizes. */
  tone?: 'color' | 'mono';
  eyes?: boolean;
}

const { class: className, tone = 'color', eyes = true } = Astro.props;
const uid = `fx${Math.random().toString(36).slice(2, 8)}`;

// Each facet: points + shade (0 = darkest … 1 = lightest)
type Facet = [string, number];
const left: Facet[] = [
  ['70,40 150,140 95,190', 0.55], // outer ear
  ['200,118 150,140 200,200', 0.8], // forehead
  ['95,190 150,140 150,215', 0.62], // temple
  ['150,140 200,200 150,215', 0.72], // brow
  ['95,190 150,215 56,252', 0.45], // upper cheek
  ['56,252 150,215 118,302', 0.95], // white cheek tuft
  ['150,215 200,200 166,290', 0.5], // under eye
  ['150,215 166,290 118,302', 0.78], // muzzle side
  ['200,200 166,290 200,312', 0.66], // muzzle top
  ['118,302 166,290 200,362', 0.88], // jaw
  ['166,290 200,312 200,362', 0.7], // chin
];
const mirror = (pts: string) =>
  pts
    .split(' ')
    .map((p) => {
      const [x, y] = p.split(',').map(Number);
      return `${400 - x},${y}`;
    })
    .join(' ');
const facets: Facet[] = [...left, ...left.map(([p, s]): Facet => [mirror(p), Math.max(0, s - 0.12)])];

const fill = (s: number) =>
  tone === 'mono' ? 'currentColor' : s > 0.85 ? `url(#${uid}-w)` : `url(#${uid}-p)`;
const opacity = (s: number) => (tone === 'mono' ? 0.35 + s * 0.65 : 0.25 + s * 0.75);
---

<svg viewBox="0 0 400 400" class:list={['pointer-events-none', className]} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${uid}-p`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#c4b5fd"></stop>
      <stop offset="0.55" stop-color="#8b5cf6"></stop>
      <stop offset="1" stop-color="#2e2659"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-w`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3f1ff"></stop>
      <stop offset="1" stop-color="#a5a3b8"></stop>
    </linearGradient>
  </defs>
  <g stroke={tone === 'mono' ? 'none' : '#09090b'} stroke-width="1.5" stroke-linejoin="round">
    {facets.map(([points, shade]) => <polygon points={points} fill={fill(shade)} fill-opacity={opacity(shade)} />)}
    <!-- inner ears -->
    <polygon points="88,78 136,140 104,168" fill={tone === 'mono' ? 'currentColor' : '#1b1a25'} fill-opacity="0.85"></polygon>
    <polygon points="312,78 264,140 296,168" fill={tone === 'mono' ? 'currentColor' : '#1b1a25'} fill-opacity="0.85"></polygon>
  </g>
  {
    eyes && (
      <g fill={tone === 'mono' ? '#09090b' : '#f3f1ff'}>
        <polygon points="132,206 178,214 146,224" />
        <polygon points="268,206 222,214 254,224" />
      </g>
    )
  }
  <polygon points="186,346 214,346 200,364" fill="#09090b"></polygon>
</svg>
