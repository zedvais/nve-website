---
/**
 * Geometric art-deco line emblems for the four values. Original artwork.
 */
import type { ValueIcon } from '@/data/site';

interface Props {
  name: ValueIcon;
  class?: string;
}
const { name, class: className } = Astro.props;

const art: Record<ValueIcon, string> = {
  // three interlocking rhombi: bound together
  loyalty:
    '<path d="M60 20 100 60 60 100 20 60Z"/><path d="M100 20 140 60 100 100 60 60Z"/><path d="M80 60 120 100 80 140 40 100Z"/><circle cx="80" cy="80" r="4" fill="currentColor"/>',
  // shield with chevrons: holding the line
  integrity:
    '<path d="M80 12 136 32V78c0 34-24 58-56 70-32-12-56-36-56-70V32Z"/><path d="M50 70 80 90 110 70"/><path d="M50 92 80 112 110 92"/><path d="M80 12V148" stroke-opacity=".4"/>',
  // two arcs lifting a diamond: holding each other up
  supportive:
    '<path d="M80 22 104 46 80 70 56 46Z"/><path d="M80 34 92 46 80 58 68 46Z" fill="currentColor" fill-opacity=".35"/><path d="M18 74c0 40 28 68 62 68s62-28 62-68"/><path d="M40 82c0 26 18 44 40 44s40-18 40-44" stroke-opacity=".5"/><path d="M80 70V126" stroke-opacity=".35"/>',
  // rising steps to a star
  ambition:
    '<path d="M14 146H50V114H82V82H114V50H146"/><path d="M14 146V114M50 114V82M82 82V50M114 50V18" stroke-opacity=".35"/><path d="M128 6l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" fill="currentColor"/>',
};
---

<svg
  viewBox="0 0 160 160"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linejoin="round"
  class:list={['pointer-events-none', className]}
  aria-hidden="true"
  focusable="false"
  set:html={art[name]}
/>
