---
/**
 * A fanned stack of three "family cards": original playing-card style
 * artwork with the faceted fox illustration. Decorative.
 */
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const cards = [
  { rotate: -14, x: '-22%', y: '4%', tone: 'back' },
  { rotate: 9, x: '20%', y: '2%', tone: 'back' },
  { rotate: -2, x: '0%', y: '0%', tone: 'front' },
] as const;
---

<div class:list={['fox-cards relative aspect-[5/6]', className]} aria-hidden="true">
  {
    cards.map((card, i) => (
      <div
        class="fox-card absolute left-1/2 top-1/2 aspect-[5/7] w-[58%] -translate-x-1/2 -translate-y-1/2"
        style={`--r:${card.rotate}deg;--x:${card.x};--y:${card.y};--i:${i}`}
      >
        <div
          class:list={[
            'relative size-full overflow-hidden rounded-[6%/4.5%] border shadow-[0_30px_60px_-20px_rgb(0_0_0/0.8)]',
            card.tone === 'front' ? 'border-fg/25 bg-[#121218]' : 'border-line bg-[#15141d]',
          ]}
        >
          {card.tone === 'front' ? (
            <>
              <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_50%_45%,rgb(139_92_246/0.28),transparent_70%)]" />
              <div class="absolute inset-[6%] rounded-[4%/3%] border border-fg/10" />
              <span class="absolute left-[9%] top-[6%] font-display text-[clamp(0.7rem,2.2vw,1.1rem)] font-bold leading-none tracking-[-0.04em] text-fg">
                {site.monogram}
                <span class="mt-1 block size-[0.5em] rotate-45 bg-accent" />
              </span>
              <span class="absolute bottom-[6%] right-[9%] rotate-180 font-display text-[clamp(0.7rem,2.2vw,1.1rem)] font-bold leading-none tracking-[-0.04em] text-fg">
                {site.monogram}
                <span class="mt-1 block size-[0.5em] rotate-45 bg-accent" />
              </span>
              <div class="absolute inset-0 grid place-items-center">
                <Logo variant="full" size={180} loading="lazy" decorative class="!h-[52%] !w-auto" />
              </div>
            </>
          ) : (
            <>
              <div class="absolute inset-[6%] rounded-[4%/3%] border border-accent-muted/60 bg-[repeating-linear-gradient(45deg,rgb(139_92_246/0.10)_0_2px,transparent_2px_12px),repeating-linear-gradient(-45deg,rgb(139_92_246/0.10)_0_2px,transparent_2px_12px)]" />
              <div class="absolute inset-0 grid place-items-center">
                <Logo variant="mark" size={60} loading="lazy" decorative class="!h-auto !w-[40%] opacity-25" />
              </div>
            </>
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  .fox-card {
    transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) rotate(var(--r));
    transition: transform 0.8s var(--ease-out-expo);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .fox-cards:hover .fox-card {
      transform: translate(calc(-50% + var(--x) * 1.25), calc(-50% + var(--y) - 2%)) rotate(calc(var(--r) * 1.35));
    }
  }
</style>
