---
/**
 * Original illustration: a fox silhouette on a rooftop watching the city
 * under a full moon. Used in the About section.
 */
import NightSkyline from './NightSkyline.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const uid = `rs${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['relative overflow-hidden', className]} aria-hidden="true">
  <svg viewBox="0 0 600 450" class="absolute inset-0 size-full" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <radialGradient id={`${uid}-sky`} cx="0.68" cy="0.28" r="0.8">
        <stop offset="0" stop-color="#4a3e8c" stop-opacity="0.75"></stop>
        <stop offset="0.45" stop-color="#1b1a25"></stop>
        <stop offset="1" stop-color="#09090b"></stop>
      </radialGradient>
      <radialGradient id={`${uid}-moon`} cx="0.4" cy="0.38" r="0.7">
        <stop offset="0" stop-color="#f3f1ff"></stop>
        <stop offset="0.7" stop-color="#d6ccff"></stop>
        <stop offset="1" stop-color="#b9a4fb"></stop>
      </radialGradient>
      <radialGradient id={`${uid}-halo`}>
        <stop offset="0" stop-color="#b9a4fb" stop-opacity="0.45"></stop>
        <stop offset="1" stop-color="#8b5cf6" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect width="600" height="450" fill={`url(#${uid}-sky)`}></rect>
    <!-- stars -->
    <g fill="#f3f1ff">
      <circle cx="60" cy="40" r="1"></circle><circle cx="140" cy="90" r="0.8"></circle>
      <circle cx="220" cy="30" r="1.2"></circle><circle cx="300" cy="70" r="0.7"></circle>
      <circle cx="520" cy="40" r="1"></circle><circle cx="560" cy="130" r="0.8"></circle>
      <circle cx="90" cy="150" r="0.7"></circle><circle cx="250" cy="140" r="0.9"></circle>
      <path d="M470 60l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" fill-opacity="0.9"></path>
    </g>
    <circle cx="410" cy="130" r="120" fill={`url(#${uid}-halo)`}></circle>
    <circle cx="410" cy="130" r="58" fill={`url(#${uid}-moon)`}></circle>
    <!-- moon craters -->
    <g fill="#4a3e8c" fill-opacity="0.18">
      <circle cx="392" cy="116" r="9"></circle><circle cx="428" cy="148" r="6"></circle><circle cx="420" cy="108" r="4"></circle>
    </g>
  </svg>

  <NightSkyline class="absolute inset-x-0 bottom-[18%] h-[52%] w-full text-[#141320]" seed={11} count={22} />
  <NightSkyline class="absolute inset-x-0 bottom-[12%] h-[40%] w-full text-[#0e0d15]" seed={29} count={16} />

  <!-- Foreground rooftop + fox -->
  <svg viewBox="0 0 600 450" class="absolute inset-0 size-full" preserveAspectRatio="xMidYMax slice" focusable="false">
    <path d="M0 400 L330 400 L330 392 L600 392 L600 450 L0 450 Z" fill="#09090b"></path>
    <path d="M0 400 L330 400 L330 392 L600 392" stroke="#4a3e8c" stroke-width="1.5" fill="none"></path>
    <!-- chimney / vent -->
    <path d="M70 400V350h34v50z M64 350h46v-8H64z" fill="#09090b"></path>
    <g transform="translate(150 192) scale(1.1)" stroke="#8b5cf6" stroke-opacity="0.55" stroke-width="1.1" stroke-linejoin="round">
      <polygon points="66,184 20,190 0,168 4,140 20,126 26,156 48,176" fill="#09090b"></polygon>
      <polygon points="0,168 4,140 12,132 9,162" fill="#f3f1ff" fill-opacity="0.75" stroke="none"></polygon>
      <polygon
        points="150,188 140,120 142,84 156,76 182,66 158,56 148,50 142,22 132,44 118,24 112,50 100,72 78,100 58,140 62,188"
        fill="#09090b"></polygon>
      <polygon points="156,76 182,66 170,74" fill="#f3f1ff" fill-opacity="0.55" stroke="none"></polygon>
      <polygon points="150,60 160,62 152,65" fill="#b9a4fb" stroke="none"></polygon>
    </g>
  </svg>
</div>
