---
/**
 * The House jewel: a brilliant-cut gem in fine gold line work, rendered in 3D on a
 * canvas. It turns slowly on its own; drag (or use the arrow keys) to spin it and
 * it coasts to a stop with inertia. Pauses off screen; with reduced motion it
 * holds still until the visitor turns it. Original artwork, no dependencies.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={['house-jewel group select-none touch-pan-y cursor-grab active:cursor-grabbing', className]}
  data-jewel
  tabindex="0"
  role="img"
  aria-label="A gold brilliant-cut jewel, slowly turning. Drag or use the arrow keys to spin it."
>
  <div class="relative size-full">
  <canvas class="block size-full" aria-hidden="true"></canvas>
  <p
    class="jewel-hint eyebrow pointer-events-none absolute inset-x-0 -bottom-7 text-center text-[0.62rem] text-muted transition-opacity duration-700"
    aria-hidden="true"
  >
    Drag to turn
  </p>
  </div>
</div>

<script>
  type V3 = [number, number, number];

  /* Geometry: table (8), crown break (8), girdle (16), culet. Unit size. */
  const TAU = Math.PI * 2;
  const ring = (n: number, r: number, y: number, offset = 0): V3[] =>
    Array.from({ length: n }, (_, i) => {
      const a = (i / n) * TAU + offset;
      return [Math.cos(a) * r, y, Math.sin(a) * r];
    });
  const table = ring(8, 0.52, -0.42);
  const star = ring(8, 0.78, -0.27, Math.PI / 8);
  const girdle = ring(16, 1, 0);
  const lower = ring(8, 0.42, 0.62);
  const culet: V3 = [0, 1.02, 0];
  const verts: V3[] = [...table, ...star, ...girdle, ...lower, culet];
  const T = 0, S = 8, G = 16, L = 32, C = 40;
  const edges: [number, number][] = [];
  for (let i = 0; i < 8; i++) {
    const n = (i + 1) % 8;
    edges.push([T + i, T + n]); // table
    edges.push([T + i, S + i], [T + n, S + i]); // star facets
    edges.push([S + i, G + 2 * i + 1]); // kite tips
    edges.push([T + i, G + 2 * i], [S + i, G + 2 * i], [S + i, G + ((2 * i + 2) % 16)]); // bezels
    edges.push([G + 2 * i, L + i], [L + i, C], [G + 2 * i + 1, L + i], [G + ((2 * i + 2) % 16), L + i]); // pavilion
  }
  for (let j = 0; j < 16; j++) edges.push([G + j, G + ((j + 1) % 16)]); // girdle

  const GOLD = [201, 164, 92];
  const GOLD_SOFT = [230, 205, 140];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-jewel]').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = 0, h = 0, dpr = 1;
    let yaw = 0.3, pitch = -0.38; // radians
    const idle = 0.00035; // radians per ms: one turn every ~18s
    let vel = reduced.matches ? 0 : idle;
    let dragging = false, lastX = 0, lastY = 0, lastT = 0;
    let visible = false, raf = 0, prev = 0, touched = false;

    const resize = () => {
      const rect = root.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      draw(performance.now());
    };

    const project = ([x, y, z]: V3) => {
      const cy = Math.cos(yaw), sy = Math.sin(yaw);
      const x1 = x * cy - z * sy, z1 = x * sy + z * cy;
      const cp = Math.cos(pitch), sp = Math.sin(pitch);
      const y2 = y * cp - z1 * sp, z2 = y * sp + z1 * cp;
      const s = Math.min(w, h) * 0.36;
      const persp = 3.2 / (3.2 + z2);
      return { x: w / 2 + x1 * s * persp, y: h * 0.47 + (y2 - 0.2) * s * persp, z: z2 };
    };

    const draw = (now: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const pts = verts.map(project);
      ctx.lineCap = 'round';

      // Back edges first, faint; front edges brighter and finer gold.
      const sorted = edges
        .map(([a, b]) => ({ a: pts[a], b: pts[b], z: (pts[a].z + pts[b].z) / 2 }))
        .sort((p, q) => q.z - p.z);
      for (const e of sorted) {
        const depth = Math.max(0, Math.min(1, (1 - e.z) / 2)); // 1 = nearest
        const c = depth > 0.5 ? GOLD_SOFT : GOLD;
        ctx.strokeStyle = `rgba(${c[0]},${c[1]},${c[2]},${(0.12 + depth * 0.7).toFixed(3)})`;
        ctx.lineWidth = 0.6 + depth * 0.9;
        ctx.beginPath();
        ctx.moveTo(e.a.x, e.a.y);
        ctx.lineTo(e.b.x, e.b.y);
        ctx.stroke();
      }

      // Glints on the nearest girdle and table points.
      const t = now / 1000;
      pts.forEach((p, i) => {
        if (i >= L || p.z > -0.35) return;
        const tw = (Math.sin(t * 2.1 + i * 1.7) + 1) / 2;
        if (tw < 0.82) return;
        const r = 1 + (tw - 0.82) * 14;
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r * 3);
        g.addColorStop(0, 'rgba(255,244,214,0.9)');
        g.addColorStop(1, 'rgba(255,244,214,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, r * 3, 0, TAU);
        ctx.fill();
      });
    };

    const tick = (now: number) => {
      const dt = Math.min(48, now - (prev || now));
      prev = now;
      if (!dragging) {
        yaw += vel * dt;
        // Ease back to a gentle idle turn (or to rest with reduced motion).
        const target = reduced.matches ? 0 : idle;
        vel += (target - vel) * Math.min(1, dt * 0.0016);
        pitch += (-0.38 - pitch) * Math.min(1, dt * 0.0012);
      }
      draw(now);
      const moving = dragging || Math.abs(vel) > 0.000005 || !reduced.matches;
      raf = visible && moving ? requestAnimationFrame(tick) : 0;
    };
    const play = () => {
      if (!raf && visible) { prev = 0; raf = requestAnimationFrame(tick); }
    };

    const markTouched = () => {
      if (touched) return;
      touched = true;
      root.querySelector('.jewel-hint')?.classList.add('opacity-0');
    };

    root.addEventListener('pointerdown', (e) => {
      dragging = true; markTouched();
      lastX = e.clientX; lastY = e.clientY; lastT = e.timeStamp;
      root.setPointerCapture(e.pointerId);
      play();
    });
    root.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX, dy = e.clientY - lastY;
      const dt = Math.max(1, e.timeStamp - lastT);
      yaw += dx * 0.011;
      pitch = Math.max(-1.1, Math.min(0.4, pitch - dy * 0.006));
      vel = (dx * 0.011) / dt; // carry the flick into inertia
      lastX = e.clientX; lastY = e.clientY; lastT = e.timeStamp;
    });
    const release = () => { dragging = false; play(); };
    root.addEventListener('pointerup', release);
    root.addEventListener('pointercancel', release);
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault(); markTouched();
      vel += e.key === 'ArrowRight' ? 0.004 : -0.004;
      play();
    });

    new ResizeObserver(resize).observe(root);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) play();
    }).observe(root);
    reduced.addEventListener('change', play);
  });
</script>
