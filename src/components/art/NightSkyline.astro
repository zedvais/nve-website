---
/**
 * Procedurally generated night city skyline (deterministic seed, built at
 * compile time, so it costs no client JS). Original artwork.
 */
interface Props {
  class?: string;
  seed?: number;
  /** Number of buildings across the 1600-wide viewBox. */
  count?: number;
  height?: number;
  windows?: boolean;
}

const { class: className, seed = 7, count = 38, height = 320, windows = true } = Astro.props;

let s = seed;
const rand = () => {
  s = (s * 16807) % 2147483647;
  return (s - 1) / 2147483646;
};

const W = 1600;
let x = -20;
let body = '';
let lit = '';
let accent = '';
const step = W / count;

for (let i = 0; i < count + 2; i++) {
  const w = step * (0.7 + rand() * 0.9);
  const h = height * (0.25 + rand() * 0.7) * (i % 7 === 3 ? 1.25 : 1);
  const top = height - h;
  const kind = rand();
  // Base block
  body += `M${x.toFixed(1)} ${height}V${top.toFixed(1)}`;
  if (kind < 0.18) {
    // Art-deco stepped crown + spire
    const st = w * 0.18;
    body += `H${(x + st).toFixed(1)}V${(top - 14).toFixed(1)}H${(x + st * 2).toFixed(1)}V${(top - 28).toFixed(1)}H${(x + w / 2 - 2).toFixed(1)}V${(top - 70).toFixed(1)}H${(x + w / 2 + 2).toFixed(1)}V${(top - 28).toFixed(1)}H${(x + w - st * 2).toFixed(1)}V${(top - 14).toFixed(1)}H${(x + w - st).toFixed(1)}V${top.toFixed(1)}`;
    accent += `<circle cx="${(x + w / 2).toFixed(1)}" cy="${(top - 72).toFixed(1)}" r="2.2"/>`;
  } else if (kind < 0.3) {
    // Slanted roof
    body += `L${(x + w).toFixed(1)} ${(top + 18).toFixed(1)}`;
    body += `H${(x + w).toFixed(1)}`;
  } else if (kind < 0.4) {
    // Water tower
    body += `H${(x + w * 0.6).toFixed(1)}V${(top - 10).toFixed(1)}H${(x + w * 0.62).toFixed(1)}V${(top - 26).toFixed(1)}H${(x + w * 0.86).toFixed(1)}V${(top - 10).toFixed(1)}H${(x + w * 0.88).toFixed(1)}V${top.toFixed(1)}`;
  }
  body += `H${(x + w).toFixed(1)}V${height}Z`;

  if (windows) {
    const cols = Math.max(1, Math.floor(w / 14));
    const rows = Math.floor(h / 18);
    for (let c = 0; c < cols; c++) {
      for (let r = 1; r < rows; r++) {
        if (rand() < 0.085) {
          const wx = x + 6 + c * ((w - 12) / cols);
          const wy = top + r * 18;
          if (rand() < 0.25) accent += `<rect x="${wx.toFixed(1)}" y="${wy.toFixed(1)}" width="4" height="7"/>`;
          else lit += `M${wx.toFixed(1)} ${wy.toFixed(1)}h4v7h-4z`;
        }
      }
    }
  }
  x += w * (0.86 + rand() * 0.1);
  if (x > W + 20) break;
}
---

<svg
  viewBox={`0 -80 ${W} ${height + 80}`}
  preserveAspectRatio="xMidYMax slice"
  class:list={['pointer-events-none', className]}
  aria-hidden="true"
  focusable="false"
>
  <path d={body} fill="currentColor"></path>
  {windows && <path d={lit} fill="#f3f1ff" fill-opacity="0.35" />}
  <g fill="#8b5cf6" fill-opacity="0.85" set:html={accent} />
</svg>
