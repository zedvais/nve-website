---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Logo from '@/components/ui/Logo.astro';
import FoxMotif from '@/components/ui/FoxMotif.astro';
import { about, site } from '@/data/site';
---

<section id="about" aria-labelledby="about-heading" class="relative py-24 sm:py-32 lg:py-40">
  <Container size="wide">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <SectionHeading id="about-heading" index={about.index} label={about.label} heading={about.heading} align="left" />
        <p class="mt-10 font-display text-2xl font-medium leading-snug sm:text-3xl" data-reveal>
          {about.lead}
        </p>
        <div class="mt-8 space-y-5 text-base leading-relaxed text-muted sm:text-lg">
          {about.body.map((para, i) => <p data-reveal style={`--reveal-delay:${i * 80}`}>{para}</p>)}
        </div>
      </div>

      <!-- Branded visual + pillars -->
      <div class="lg:col-span-5 lg:col-start-8" data-reveal style="--reveal-delay:120">
        <div class="relative overflow-hidden border border-line bg-surface">
          <div class="relative aspect-[4/3] overflow-hidden border-b border-line">
            <div class="grid-lines absolute inset-0 opacity-70" aria-hidden="true"></div>
            <div class="absolute inset-0 bg-[radial-gradient(60%_60%_at_50%_50%,rgb(139_92_246/0.22),transparent_70%)]" aria-hidden="true"></div>
            <FoxMotif class="absolute left-1/2 top-1/2 w-[90%] -translate-x-1/2 -translate-y-1/2 text-fg/[0.06]" />
            <div class="absolute inset-0 grid place-items-center">
              <Logo variant="full" size={230} loading="lazy" decorative class="!h-[62%] !w-auto drop-shadow-[0_20px_40px_rgb(0_0_0/0.6)]" />
            </div>
            <div class="absolute inset-x-0 bottom-0 flex items-end justify-between p-5 sm:p-6">
              <span class="eyebrow text-fg/80">{site.name}</span>
              <span class="eyebrow text-fg/60">{site.shortName}</span>
            </div>
          </div>
          <ul class="divide-y divide-line">
            {
              about.pillars.map((pillar, i) => (
                <li class="group grid grid-cols-[2.5rem_1fr] gap-x-4 px-5 py-5 transition-colors duration-300 hover:bg-elevated sm:px-6">
                  <span class="font-display text-xs tracking-[0.2em] text-accent-soft">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="font-display text-base font-semibold uppercase tracking-[0.08em]">{pillar.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted">{pillar.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
