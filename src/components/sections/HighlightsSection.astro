---
import CityMap from '@/components/art/CityMap.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import HighlightCard from '@/components/ui/HighlightCard.astro';
import StatsPanel from '@/components/ui/StatsPanel.astro';
import PerkList from '@/components/ui/PerkList.astro';
import { journey } from '@/data/site';
import { highlights } from '@/data/highlights';
---

<section id="journey" aria-labelledby="journey-heading" class="relative isolate overflow-hidden border-t border-line py-24 sm:py-32 lg:py-40" data-scene>
  <CityMap class="absolute inset-x-0 top-0 -z-10 h-[34rem] w-full opacity-80 [mask-image:linear-gradient(to_bottom,black_30%,transparent)]" />
  <Container size="wide">
    <SectionHeading id="journey-heading" index={journey.index} label={journey.label} heading={journey.heading} intro={journey.intro} />

    <div class="mt-16 space-y-3 lg:mt-24">
      <StatsPanel />
      <PerkList />
    </div>

    <h3 class="eyebrow mb-6 mt-20 flex items-center gap-3">
      <span class="h-px w-8 bg-line" aria-hidden="true"></span>Milestones
    </h3>
    <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
      {
        highlights.map((highlight, i) => (
          <li
            class:list={['lg:col-span-2', highlights.length % 3 === 2 && i >= highlights.length - 2 && 'lg:col-span-3']}
            data-reveal
            style={`--reveal-delay:${(i % 3) * 90}`}
          >
            <HighlightCard highlight={highlight} index={i} />
          </li>
        ))
      }
    </ol>
  </Container>
</section>
