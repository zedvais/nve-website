---
import CityMap from '@/components/art/CityMap.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import HighlightCard from '@/components/ui/HighlightCard.astro';
import { journey } from '@/data/site';
import { highlights } from '@/data/highlights';
---

<section id="journey" aria-labelledby="journey-heading" class="relative isolate overflow-hidden border-t border-line py-24 sm:py-32 lg:py-40">
  <CityMap class="absolute inset-x-0 top-0 -z-10 h-[34rem] w-full opacity-80 [mask-image:linear-gradient(to_bottom,black_30%,transparent)]" />
  <Container size="wide">
    <SectionHeading id="journey-heading" index={journey.index} label={journey.label} heading={journey.heading} intro={journey.intro} />

    <ol class="mt-16 grid gap-3 sm:grid-cols-2 lg:mt-24 lg:grid-cols-6">
      {
        highlights.map((highlight, i) => (
          <li
            class:list={['lg:col-span-2', i >= 3 && 'lg:col-span-3']}
            data-reveal
            style={`--reveal-delay:${(i % 3) * 90}`}
          >
            <HighlightCard highlight={highlight} index={i} />
          </li>
        ))
      }
    </ol>
  </Container>
</section>
