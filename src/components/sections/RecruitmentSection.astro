---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import FoxMotif from '@/components/ui/FoxMotif.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { recruitment } from '@/data/site';
import { discord, hasDiscord } from '@/data/socials';

const applyHref = recruitment.applicationUrl || (hasDiscord ? discord.url : undefined);
const discordHref = hasDiscord ? discord.url : undefined;
const anyLink = Boolean(applyHref || discordHref);
---

<section id="join" aria-labelledby="join-heading" class="relative py-24 sm:py-32 lg:py-40">
  <Container size="wide">
    <div class="relative isolate overflow-hidden border border-line bg-elevated/60" data-reveal>
      <!-- Atmosphere -->
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute inset-0 bg-[radial-gradient(70%_90%_at_100%_0%,rgb(139_92_246/0.25),transparent_60%)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(50%_70%_at_0%_100%,rgb(74_62_140/0.25),transparent_70%)]"></div>
        <div class="grid-lines absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
        <div class="grain absolute inset-0"></div>
      </div>
      <FoxMotif class="absolute -right-24 -top-16 -z-10 w-[30rem] text-fg/[0.07] sm:w-[38rem]" />
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/80 to-transparent" aria-hidden="true"></div>

      <div class="grid gap-14 p-7 sm:p-12 lg:grid-cols-12 lg:gap-10 lg:p-16 xl:p-20">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-6 flex items-center gap-3">
            <span class="text-accent-soft">{recruitment.index}</span>
            <span class="h-px w-8 bg-line" aria-hidden="true"></span>
            <span>{recruitment.label}</span>
          </p>
          <h2 id="join-heading" class="display text-[clamp(2.75rem,8vw,7rem)]">
            {recruitment.heading}
          </h2>
          <p class="mt-8 max-w-xl font-display text-xl font-medium leading-snug text-fg/90 sm:text-2xl">
            {recruitment.statement}
          </p>

          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <Button href={applyHref} external={Boolean(applyHref)} size="lg">
              {recruitment.primaryCta.label}
              <ArrowRight size={16} stroke-width={2} class="transition-transform duration-300 group-hover/btn:translate-x-1" aria-hidden="true" />
            </Button>
            <Button href={discordHref} external={Boolean(discordHref)} variant="secondary" size="lg">
              <SocialIcon icon="discord" size={18} />
              {recruitment.secondaryCta.label}
            </Button>
          </div>
          {!anyLink && <p class="mt-4 text-sm text-muted">{recruitment.unavailableNote}</p>}
        </div>

        <div class="lg:col-span-5">
          <h3 class="eyebrow mb-4 border-b border-line pb-4">What we look for</h3>
          <ul class="divide-y divide-line/80">
            {
              recruitment.expectations.map((item) => (
                <li class="flex gap-4 py-4">
                  <span class="mt-0.5 grid size-6 shrink-0 place-items-center border border-accent-muted text-accent-soft">
                    <Check size={14} stroke-width={2} aria-hidden="true" />
                  </span>
                  <div>
                    <p class="font-display font-semibold">{item.title}</p>
                    <p class="mt-1 text-sm leading-relaxed text-muted">{item.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
