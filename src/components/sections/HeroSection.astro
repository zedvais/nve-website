---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Crest from '@/components/ui/Crest.astro';
import DecoSunburst from '@/components/art/DecoSunburst.astro';
import GoldDust from '@/components/art/GoldDust.astro';
import { game, hero, site } from '@/data/site';
import { tagLetters } from '@/lib/tag';
import { foundedShort, openSeats, stats } from '@/data/stats';

const heroLetters = tagLetters(hero.heading, site.shortName);

const status = [
  { label: 'War record', value: `${stats.wars.won}–${stats.wars.lost}` },
  { label: 'Family level', value: `Lv. ${stats.level}` },
  { label: 'Founded', value: foundedShort },
  {
    label: 'Recruitment',
    value: game.recruiting && openSeats > 0 ? `Open · ${openSeats} seats` : 'Closed',
    live: game.recruiting && openSeats > 0,
  },
];
---

<section id="home" aria-labelledby="hero-heading" class="relative isolate flex min-h-svh flex-col overflow-hidden" data-scene data-pointer-light>
  <!-- Atmosphere: deco sunburst, warm lamplight, grain -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-x-0 bottom-0 h-[70%] bg-[radial-gradient(60%_70%_at_50%_100%,rgb(201_164_92/0.13),transparent_70%)]"></div>
    <DecoSunburst class="absolute inset-0 size-full opacity-70" />
    <!-- the same rays, brighter, seen only through a soft light that follows the pointer (drifts on its own on touch) -->
    <DecoSunburst class="hero-lit absolute inset-0 size-full" strength={1} />
    <GoldDust class="absolute inset-0" count={18} seed={7} />
    <div class="absolute inset-0 bg-[radial-gradient(45%_40%_at_50%_42%,var(--color-bg)_20%,transparent_100%)] opacity-80"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-bg/80 via-transparent to-bg"></div>
    <div class="grain absolute inset-0"></div>
  </div>

  <Container size="wide" class="flex flex-1 flex-col pb-10 pt-28 sm:pt-32">
    <div class="flex items-center justify-between gap-6">
      <p class="eyebrow intro flex items-center gap-3" style="--intro-delay:100">
        <span class="inline-block size-1.5 rotate-45 bg-accent" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>
      <p class="eyebrow intro hidden sm:block" style="--intro-delay:150">Est. {site.established}</p>
    </div>

    <div class="my-auto flex flex-col items-center py-10 text-center sm:py-12">
      <Crest animated delay={150} class="crest-glow w-[min(40vw,9rem)] sm:w-[10.5rem]" />

      <h1 id="hero-heading" class="mt-7 flex flex-col items-center sm:mt-8">
        <span class="intro font-serif text-xl italic text-muted sm:text-2xl" style="--intro-delay:300">{site.house}</span>
        <span class="sr-only">{site.name}</span>
        <span class="engraved mt-3 flex pl-[0.16em] text-[clamp(2.4rem,10.5vw,7.5rem)] font-medium" aria-hidden="true">
          {
            heroLetters.map((l, i) => (
              <span class:list={['intro block', l.tag ? 'gilt' : 'text-fg']} style={`--intro-delay:${380 + i * 60}`}>
                {l.char}
              </span>
            ))
          }
        </span>
      </h1>

      <p class="intro mt-6 flex items-center gap-4" style="--intro-delay:860">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-accent-muted sm:w-16" aria-hidden="true"></span>
        <span class="font-display text-xs font-semibold tracking-[0.42em] text-accent-soft">{site.shortName}</span>
        <span class="size-1 rotate-45 bg-accent-muted" aria-hidden="true"></span>
        <span class="eyebrow">{site.pronunciation}</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-accent-muted sm:w-16" aria-hidden="true"></span>
      </p>

      <p class="intro mt-8 font-serif text-2xl italic text-fg/90 sm:text-3xl" style="--intro-delay:940">{hero.tagline}</p>
      <p class="intro mt-4 max-w-xl leading-relaxed text-muted sm:text-lg" style="--intro-delay:1000">{hero.description}</p>

      <div class="intro mt-10 flex w-full flex-col gap-3 sm:w-auto sm:flex-row" style="--intro-delay:1080">
        <Button href={hero.primaryCta.href} size="lg">
          {hero.primaryCta.label}
          <ArrowRight size={16} stroke-width={1.75} class="transition-transform duration-300 group-hover/btn:translate-x-1" aria-hidden="true" />
        </Button>
        <Button href={hero.secondaryCta.href} variant="secondary" size="lg">
          {hero.secondaryCta.label}
        </Button>
      </div>
    </div>

    <dl class="intro deco-frame mx-auto grid w-full max-w-4xl grid-cols-2 bg-bg/60 backdrop-blur-sm sm:grid-cols-4" style="--intro-delay:1200">
      {
        status.map((item, i) => (
          <div class:list={['px-4 py-4 text-center sm:px-5', i % 2 === 1 && 'border-l border-line', i >= 2 && 'border-t border-line sm:border-t-0', i === 2 && 'sm:border-l']}>
            <dt class="eyebrow !text-[0.62rem]">{item.label}</dt>
            <dd class="mt-1.5 flex items-center justify-center gap-2 font-serif text-lg font-medium tabular-nums">
              {item.live && <span class="size-1.5 rotate-45 bg-accent shadow-[0_0_0_3px_rgb(201_164_92/0.2)]" aria-hidden="true" />}
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>

<style>
  .crest-glow {
    filter: drop-shadow(0 0 28px rgb(201 164 92 / 0.18)) drop-shadow(0 18px 30px rgb(0 0 0 / 0.6));
  }
</style>
