---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import FoxMotif from '@/components/ui/FoxMotif.astro';
import { Image } from 'astro:assets';
import { game, hero, site } from '@/data/site';
import { foundedShort, openSeats, stats } from '@/data/stats';

const status = [
  { label: 'Game', value: `${game.name} · ${game.platform}` },
  { label: 'Family level', value: `Lv. ${stats.level}` },
  { label: 'Founded', value: foundedShort },
  {
    label: 'Recruitment',
    value: game.recruiting && openSeats > 0 ? `Open · ${openSeats} seats` : 'Closed',
    live: game.recruiting && openSeats > 0,
  },
];
---

<section id="home" aria-labelledby="hero-heading" class="relative isolate flex min-h-svh flex-col overflow-hidden">
  <!-- Atmosphere: rooftop photo, purple light, grain -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Image
      src={site.heroBackground}
      alt=""
      widths={[640, 960, 1376]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="intro-fade absolute inset-0 size-full -scale-x-100 object-cover object-[37%_center] opacity-80 lg:object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-bg/95 via-bg/60 to-bg/0"></div>
    <div class="absolute inset-0 bg-bg/35 lg:hidden"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-bg/70 via-transparent to-bg"></div>
    <div class="intro-fade absolute -right-[20%] -top-[30%] h-[110vh] w-[110vh] rounded-full bg-[radial-gradient(closest-side,rgb(139_92_246/0.18),transparent)] blur-2xl"></div>
    <div class="grid-lines absolute inset-0 opacity-50 [mask-image:radial-gradient(ellipse_80%_70%_at_60%_40%,black,transparent)]"></div>
    <div class="grain absolute inset-0"></div>
  </div>

  <Container size="wide" class="flex flex-1 flex-col pb-10 pt-28 sm:pt-32 lg:pt-36">
    <div class="flex items-center justify-between gap-6">
      <p class="eyebrow intro flex items-center gap-3" style="--intro-delay:100">
        <span class="inline-block size-1.5 bg-accent" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>
      <p class="eyebrow intro hidden sm:block" style="--intro-delay:150">{game.platform} / {game.name}</p>
    </div>

    <div class="my-auto py-14">
      <h1 id="hero-heading" class="display text-[clamp(3.6rem,20vw,14.5rem)] leading-[0.82]">
        <span class="sr-only">{site.name}</span>
        {
          hero.heading.map((word, i) => (
            <span class="block overflow-hidden pb-[0.04em]" aria-hidden="true">
              <span
                class:list={['intro block', i === 1 && 'pl-[0.6em] text-transparent [-webkit-text-stroke:1.5px_var(--color-fg)] sm:pl-[1.1em]']}
                style={`--intro-delay:${200 + i * 140}`}
              >
                {word}
              </span>
            </span>
          ))
        }
      </h1>
    </div>

    <div class="grid gap-10 border-t border-line pt-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <p class="intro font-display text-xl font-medium sm:text-2xl" style="--intro-delay:520">
          {hero.tagline}
        </p>
        <p class="intro mt-4 max-w-xl leading-relaxed text-muted sm:text-lg" style="--intro-delay:600">
          {hero.description}
        </p>
      </div>
      <div class="intro flex flex-col gap-3 sm:flex-row lg:col-span-6 lg:justify-end" style="--intro-delay:700">
        <Button href={hero.primaryCta.href} size="lg">
          {hero.primaryCta.label}
          <ArrowRight size={16} stroke-width={2} class="transition-transform duration-300 group-hover/btn:translate-x-1" aria-hidden="true" />
        </Button>
        <Button href={hero.secondaryCta.href} variant="secondary" size="lg">
          {hero.secondaryCta.label}
        </Button>
      </div>
    </div>

    <dl class="intro mt-10 grid grid-cols-2 border-l border-t border-line sm:grid-cols-4" style="--intro-delay:800">
      {
        status.map((item) => (
          <div class="border-b border-r border-line px-4 py-3 sm:px-5">
            <dt class="eyebrow !text-[0.65rem]">{item.label}</dt>
            <dd class="mt-1 flex items-center gap-2 font-display text-sm font-semibold uppercase tracking-[0.1em]">
              {item.live && <span class="size-1.5 rounded-full bg-accent shadow-[0_0_0_3px_rgb(139_92_246/0.25)]" aria-hidden="true" />}
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <a
      href="#about"
      class="intro-fade group mt-8 hidden items-center gap-4 self-start text-muted transition-colors hover:text-fg sm:flex"
      style="--intro-delay:1000"
    >
      <span class="relative block h-12 w-px overflow-hidden bg-line" aria-hidden="true">
        <span class="scroll-cue absolute inset-0 bg-accent"></span>
      </span>
      <span class="eyebrow group-hover:text-fg">Scroll</span>
      <span class="sr-only">to the About section</span>
    </a>
  </Container>
</section>
