---
import { journey } from '@/data/site';
import { asOfLabel, formatNumber, stats, xpPercent } from '@/data/stats';

const tiles = [
  { label: 'Family level', value: String(stats.level) },
  { label: 'Members', value: String(stats.members.current), max: String(stats.members.max) },
  { label: 'Respect', value: formatNumber(stats.respect) },
  { label: 'Perk levels', value: String(stats.perkLevels.current), max: String(stats.perkLevels.max) },
];
const badges = [
  ...stats.rankings.map((r) => `#${r.rank} in ${r.label.toLowerCase()}`),
  `${stats.territories} territories held`,
  `${stats.wars.won}–${stats.wars.lost} in family wars`,
];
---

<div class="relative overflow-hidden border border-line bg-surface/80 p-6 backdrop-blur-sm sm:p-10" data-reveal>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/70 to-transparent" aria-hidden="true"></div>

  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h3 class="font-display text-2xl font-semibold sm:text-3xl">{journey.statsHeading}</h3>
      <p class="mt-2 text-sm text-muted">Stats as of {asOfLabel}</p>
    </div>
    <ul class="flex flex-wrap gap-2" aria-label="Rankings">
      {
        badges.map((b) => (
          <li class="border border-accent-muted bg-accent/10 px-3 py-1.5 font-display text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-accent-soft">
            {b}
          </li>
        ))
      }
    </ul>
  </div>

  <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden border border-line bg-line lg:grid-cols-4">
    {
      tiles.map((t) => (
        <div class="bg-bg p-5 sm:p-6">
          <dt class="eyebrow !text-[0.68rem]">{t.label}</dt>
          <dd class="mt-3 whitespace-nowrap font-display font-bold tabular-nums leading-none tracking-[-0.03em]">
            <span class="text-[clamp(2rem,5vw,3.5rem)]">{t.value}</span>
            {t.max && <span class="ml-1 text-base text-muted sm:text-2xl">/ {t.max}</span>}
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <p class="eyebrow" id="xp-label">Family XP · to level {stats.level + 1}</p>
      <p class="font-display text-sm tabular-nums">
        {formatNumber(stats.xp.current)} <span class="text-muted">/ {formatNumber(stats.xp.next)}</span>
      </p>
    </div>
    <div
      class="mt-3 h-2.5 overflow-hidden border border-line bg-bg"
      role="progressbar"
      aria-labelledby="xp-label"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow={xpPercent}
      aria-valuetext={`${xpPercent}% of the way to level ${stats.level + 1}`}
    >
      <div
        class="xp-fill h-full bg-gradient-to-r from-accent-muted via-accent to-accent-soft shadow-[0_0_16px_rgb(139_92_246/0.6)]"
        style={`width:${xpPercent}%`}
      >
      </div>
    </div>
    <p class="mt-2 text-right text-xs text-muted">{xpPercent}%</p>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] .xp-fill {
      transform-origin: left;
      transform: scaleX(0);
      transition: transform 1.6s var(--ease-out-expo) 0.3s;
    }
    :global(.js) [data-reveal].is-visible .xp-fill {
      transform: none;
    }
  }
</style>
