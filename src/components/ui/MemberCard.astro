---
/**
 * One entry in the house ledger.
 * - feature: the heads of the house (Boss, Underbosses, the Advisor), a framed portrait
 * - default: Capos, a smaller framed entry
 * - compact: Soldiers and Associates, a ruled ledger line with a dotted leader
 */
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { Image } from 'astro:assets';
import type { Member } from '@/data/members';
import type { RobloxProfile } from '@/lib/roblox';
import Crest from '@/components/ui/Crest.astro';

interface Props {
  member: Member;
  /** Roblox data fetched at build time, when available. */
  profile?: RobloxProfile;
  variant?: 'feature' | 'default' | 'compact';
  /** Position in the ledger, shown as "No. 07". */
  entry?: number;
}

const { member, profile, variant = 'default', entry } = Astro.props;

const avatarSize = { feature: 'size-24 sm:size-28', default: 'size-16', compact: 'size-10' }[variant];
const avatarPx = { feature: 112, default: 64, compact: 40 }[variant];
const showDisplayName = profile && profile.displayName && profile.displayName !== member.name;
const Tag = profile ? 'a' : 'article';
const linkProps = profile ? { href: profile.profileUrl, target: '_blank', rel: 'noopener noreferrer' } : {};
const no = entry ? String(entry).padStart(2, '0') : undefined;
const rank = `${member.role}${member.title ? ` · ${member.title}` : ''}`;
---

{
  variant === 'compact' ? (
    <Tag {...linkProps} class="group flex h-full items-center gap-4 border-b border-line py-3 transition-colors duration-500 hover:border-accent-muted">
      {no && <span class="w-7 shrink-0 font-serif text-sm italic tabular-nums text-accent/70">{no}</span>}
      <span class="relative grid size-10 shrink-0 place-items-center overflow-hidden rounded-full bg-surface ring-1 ring-accent-muted transition duration-500 group-hover:ring-accent">
        {profile?.headshotUrl ? (
          <img src={profile.headshotUrl} alt="" width={avatarPx} height={avatarPx} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="size-full object-cover" />
        ) : (
          <Crest variant="mark" class="w-[46%] opacity-40" />
        )}
      </span>
      <span class="flex min-w-0 flex-1 items-baseline gap-3">
        <span class="truncate font-serif text-lg font-medium text-fg transition-colors duration-500 group-hover:text-accent-soft" title={member.name}>
          {member.name}
        </span>
        <span class="mb-1 min-w-4 flex-1 border-b border-dotted border-accent-muted/70" aria-hidden="true" />
        <span class="shrink-0 font-display text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-muted">{rank}</span>
      </span>
      {profile && <span class="sr-only">Roblox profile (opens in a new tab)</span>}
    </Tag>
  ) : (
    <Tag
      {...linkProps}
      class:list={[
        'deco-frame group relative flex h-full bg-bg transition-colors duration-500 hover:border-accent-muted hover:bg-elevated',
        variant === 'feature' && 'flex-col gap-7 p-7 sm:flex-row sm:items-center sm:p-9',
        variant === 'default' && 'flex-col gap-6 p-6 sm:p-7',
      ]}
    >
      <!-- deco corner brackets -->
      <span class="pointer-events-none absolute inset-[5px] opacity-0 transition-opacity duration-700 group-hover:opacity-100" aria-hidden="true">
        <span class="absolute left-0 top-0 size-4 border-l border-t border-accent" />
        <span class="absolute right-0 top-0 size-4 border-r border-t border-accent" />
        <span class="absolute bottom-0 left-0 size-4 border-b border-l border-accent" />
        <span class="absolute bottom-0 right-0 size-4 border-b border-r border-accent" />
      </span>

      <div class:list={['relative grid shrink-0 place-items-center overflow-hidden rounded-full bg-surface ring-1 ring-accent-muted ring-offset-4 ring-offset-bg transition duration-500 group-hover:ring-accent group-hover:ring-offset-elevated', avatarSize]}>
        {member.avatar ? (
          <Image src={member.avatar} alt="" width={avatarPx * 2} height={avatarPx * 2} loading="lazy" class="relative size-full object-cover" />
        ) : profile?.headshotUrl ? (
          <>
            <div class="absolute inset-0 bg-[radial-gradient(closest-side,rgb(201_164_92/0.3),transparent)]" aria-hidden="true" />
            <img
              src={profile.headshotUrl}
              alt=""
              width={avatarPx}
              height={avatarPx}
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              class="relative size-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </>
        ) : (
          <Crest variant="mark" class="relative w-[42%] opacity-40 transition-opacity duration-500 group-hover:opacity-80" />
        )}
      </div>

      <div class="min-w-0">
        <p class="eyebrow mb-2 flex items-center gap-3 !text-accent-soft">
          {no && <span class="font-serif text-sm normal-case italic tracking-normal text-accent/70">No. {no}</span>}
          {rank}
        </p>
        <h4 class:list={['truncate font-serif font-medium', variant === 'feature' ? 'text-3xl sm:text-4xl' : 'text-2xl']} title={member.name}>
          {member.name}
        </h4>
        {showDisplayName && <p class="mt-1 truncate text-sm italic text-muted">{profile.displayName}</p>}
        {member.bio && <p class="mt-3 text-sm leading-relaxed text-muted">{member.bio}</p>}
      </div>

      {profile && (
        <span class="absolute right-4 top-4 inline-flex items-center gap-1 font-display text-[0.6rem] uppercase tracking-[0.18em] text-muted transition-colors duration-300 group-hover:text-accent-soft">
          Roblox
          <ArrowUpRight size={14} stroke-width={1.5} aria-hidden="true" />
          <span class="sr-only">profile (opens in a new tab)</span>
        </span>
      )}
      {!profile && member.placeholder && (
        <span class="absolute right-4 top-4 border border-line px-2 py-0.5 font-display text-[0.6rem] uppercase tracking-[0.18em] text-muted">Placeholder</span>
      )}
    </Tag>
  )
}
