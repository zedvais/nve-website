---
/**
 * The Navierre monogram at a fixed height: the ringed N, or the N alone.
 */
import Crest from '@/components/ui/Crest.astro';
import { site } from '@/data/site';

interface Props {
  /** Rendered height in px. */
  size?: number;
  class?: string;
  /** 'full' = the N in its double ring; 'mark' = the N alone. */
  variant?: 'full' | 'mark';
  /** Set when the logo sits next to the visible name, so it is not announced twice. */
  decorative?: boolean;
}

const { size = 40, class: className, variant = 'full', decorative = false } = Astro.props;
const ratio = variant === 'mark' ? 48 / 64 : 1;
---

<span class:list={['inline-block shrink-0', className]} style={`height:${size}px;width:${Math.round(size * ratio)}px`}>
  <Crest variant={variant} title={decorative ? undefined : site.logo.alt} class="size-full" />
</span>
