---
/**
 * Official Noctus Volpe mark. `variant="mark"` is the simple white NV used at
 * small sizes; `variant="full"` is the silver-and-purple fox monogram.
 */
import { Image } from 'astro:assets';
import { site } from '@/data/site';

interface Props {
  /** Rendered height in px. */
  size?: number;
  class?: string;
  variant?: 'mark' | 'full' | 'lockup';
  /** Set when the logo sits next to the visible wordmark, so it is not announced twice. */
  decorative?: boolean;
  loading?: 'eager' | 'lazy';
}

const { size = 40, class: className, variant = 'mark', decorative = false, loading = 'eager' } = Astro.props;
const src = site.logo[variant];
const width = Math.round((size * src.width) / src.height);
---

<Image
  src={src}
  alt={decorative ? '' : site.logo.alt}
  height={size}
  width={width}
  densities={[1, 2]}
  loading={loading}
  class:list={['block h-auto shrink-0 object-contain', className]}
  style={`height:${size}px;width:${width}px`}
/>
